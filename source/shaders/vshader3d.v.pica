; vshader3d.v.pica
; Shader vertex minimal : position (v0) + couleur (v1) -> position projetée + couleur.

; Uniforms
.fvec projection[4]
.fvec modelView[4]

; Outputs
.out outpos position
.out outclr color

; Inputs
.alias inpos v0
.alias inclr v1

; Constante 1.0 pour forcer le w de la position
.constf one(0.0, 1.0, 0.0, 0.0)
.alias  ones one.yyyy

.proc main
        ; r0 = (inpos.xyz, 1.0)
        mov r0.xyz, inpos
        mov r0.w,   ones

        ; r1 = modelView * r0
        dp4 r1.x, modelView[0], r0
        dp4 r1.y, modelView[1], r0
        dp4 r1.z, modelView[2], r0
        dp4 r1.w, modelView[3], r0

        ; outpos = projection * r1
        dp4 outpos.x, projection[0], r1
        dp4 outpos.y, projection[1], r1
        dp4 outpos.z, projection[2], r1
        dp4 outpos.w, projection[3], r1

        ; outclr = inclr
        mov outclr, inclr

        end
.end